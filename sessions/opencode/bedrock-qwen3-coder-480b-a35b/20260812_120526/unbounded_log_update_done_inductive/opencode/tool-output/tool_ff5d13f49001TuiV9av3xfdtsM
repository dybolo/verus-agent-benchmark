ures\n56:             op == res,\n57:     {\n58:         unimplemented!()\n59:     }\n60: \n61:     #[verifier(external_body)]\n62:     fn dispatch(&self, op: Self::ReadOperation) -> (result: Self::Response)\n63:         ensures\n64:             Self::dispatch_spec(self@, op) == result,\n65:     {\n66:         unimplemented!()\n67:     }\n68: \n69:     #[verifier(external_body)]\n70:     fn dispatch_mut(&mut self, op: Self::WriteOperation) -> (result: Self::Response)\n71:         ensures\n72:             Self::dispatch_mut_spec(old(self)@, op) == (final(self)@, result),\n73:     {\n74:         unimplemented!()\n75:     }\n76: \n77:     spec fn init_spec() -> Self::View;\n78: \n79:     spec fn dispatch_spec(ds: Self::View, op: Self::ReadOperation) -> Self::Response;\n80: \n81:     spec fn dispatch_mut_spec(ds: Self::View, op: Self::WriteOperation) -> (\n82:         Self::View,\n83:         Self::Response,\n84:     );\n85: }\n86: \n87: #[is_variant]\n88: #[verus::trusted]\n89: pub enum InputOperation<DT: Dispatch> {\n90:     Read(DT::ReadOperation),\n91:     Write(DT::WriteOperation),\n92: }\n93: \n94: #[is_variant]\n95: #[verus::trusted]\n96: pub enum OutputOperation<DT: Dispatch> {\n97:     Read(DT::Response),\n98:     Write(DT::Response),\n99: }\n100: \n101: #[verus::trusted]\n102: pub open spec fn add_ticket<DT: Dispatch>(\n103:     pre: UnboundedLog::State<DT>,\n104:     post: UnboundedLog::State<DT>,\n105:     input: InputOperation<DT>,\n106:     rid: ReqId,\n107: ) -> bool {\n108:     !pre.local_reads.dom().contains(rid) && !pre.local_updates.dom().contains(rid) && (match input {\n109:         InputOperation::Read(read_op) => {\n110:             post == UnboundedLog::State::<DT> {\n111:                 local_reads: pre.local_reads.insert(\n112:                     rid,\n113:                     ReadonlyState::Init { op: read_op },\n114:                 ),\n115:                 ..pre\n116:             }\n117:         },\n118:         InputOperation::Write(write_op) => {\n119:             post == UnboundedLog::State::<DT> {\n120:                 local_updates: pre.local_updates.insert(\n121:                     rid,\n122:                     UpdateState::Init { op: write_op },\n123:                 ),\n124:                 ..pre\n125:             }\n126:         },\n127:     })\n128: }\n129: \n130: #[verus::trusted]\n131: pub open spec fn consume_stub<DT: Dispatch>(\n132:     pre: UnboundedLog::State<DT>,\n133:     post: UnboundedLog::State<DT>,\n134:     output: OutputOperation<DT>,\n135:     rid: ReqId,\n136: ) -> bool {\n137:     match output {\n138:         OutputOperation::Read(response) => {\n139:             pre.local_reads.dom().contains(rid) && pre.local_reads[rid].is_Done()\n140:                 && pre.local_reads[rid].get_Done_ret() == response && post == UnboundedLog::State::<\n141:                 DT,\n142:             > { local_reads: pre.local_reads.remove(rid), ..pre }\n143:         },\n144:         OutputOperation::Write(response) => {\n145:             pre.local_updates.dom().contains(rid) && pre.local_updates[rid].is_Done()\n146:                 && pre.local_updates[rid].get_Done_ret() == response && post\n147:                 == UnboundedLog::State::<DT> { local_updates: pre.local_updates.remove(rid), ..pre }\n148:         },\n149:     }\n150: }\n151: \n152: ////////////////////////////////////////////////////////////////////////////////////////////////////\n153: // Inlined from src/spec/types.rs\n154: ////////////////////////////////////////////////////////////////////////////////////////////////////\n155: \n156: /// This represents an entry in the abstract log\n157: pub tracked struct LogEntry<DT: Dispatch> {\n158:     pub op: DT::WriteOperation,\n159:     pub node_id: NodeId,\n160: }\n161: \n162: /// Represents an entry in the log\n163: pub struct ConcreteLogEntry<DT: Dispatch> {\n164:     pub op: DT::WriteOperation,\n165:     pub node_id: u64,\n166: }\n167: \n168: ////////////////////////////////////////////////////////////////////////////////////////////////////\n169: // Inlined from src/spec/utils.rs\n170: ////////////////////////////////////////////////////////////////////////////////////////////////////\n171: \n172: pub open spec fn seq_unique<A>(seq: Seq<A>) -> bool {\n173:     forall|i: int, j: int|\n174:         (0 <= i < seq.len() && 0 <= j < seq.len() && i != j) ==> seq.index(i as int) !== seq.index(\n175:             j as int,\n176:         )\n177: }\n178: \n179: pub open spec fn seq_disjoint<A>(s: Seq<A>, t: Seq<A>) -> bool {\n180:     forall|i, j| 0 <= i < s.len() && 0 <= j < t.len() ==> s.index(i) !== t.index(j)\n181: }\n182: \n183: pub open spec fn seq_to_set<A>(seq: Seq<A>) -> Set<A> {\n184:     seq.to_set()\n185: }\n186: \n187: pub open spec fn map_new_rec<V>(dom: nat, val: V) -> Map<nat, V>\n188:     decreases dom,\n189:     when dom >= 0\n190: {\n191:     if dom == 0 {\n192:         map![ dom => val]\n193:     } else {\n194:         map_new_rec((dom - 1) as nat, val).insert(dom, val)\n195:     }\n196: }\n197: \n198: #[verifier::external_body]\n199: pub proof fn map_new_rec_dom_finite<V>(dom: nat, val: V)\n200:     ensures\n201:         map_new_rec(dom, val).dom().finite(),\n202:         forall|n: nat| 0 <= n <= dom <==> map_new_rec(dom, val).contains_key(n),\n203:         forall|n|\n204:             (#[trigger] map_new_rec(dom, val).contains_key(n)) ==> map_new_rec(dom, val)[n] == val,\n205: {\n206: }\n207: \n208: pub open spec fn map_contains_value<K, V>(map: Map<K, V>, val: V) -> bool {\n209:     exists|i: K| #[trigger] map.contains_key(i) && map.index(i) == val\n210: }\n211: \n212: pub open spec fn range(low: nat, mid: nat, high: nat) -> bool {\n213:     low <= mid && mid < high\n214: }\n215: \n216: pub open spec fn rangeincl(low: nat, mid: nat, high: nat) -> bool {\n217:     low <= mid && mid <= high\n218: }\n219: \n220: #[verifier(nonlinear)]\n221: #[verifier::external_body]\n222: pub proof fn int_mod_less_than_same(i: int, len: int)\n223:     requires\n224:         0 <= i < len,\n225:         len > 0,\n226:     ensures\n227:         (i % len) == i,\n228: {\n229: }\n230: \n231: ////////////////////////////////////////////////////////////////////////////////////////////////////\n232: //\n233: // Unbounded Log\n234: // =============\n235: //\n236: // The UnboundedLog is the first Refinement of the SimpleLog. As its name suggests, it also uses\n237: // an unbounded log to represent updates to the data structure, however the log itself is represented\n238: // by a map instead of a sequence. Moreover, the state machine also manages the data structure\n239: // replicas.\n240: //\n241: ////////////////////////////////////////////////////////////////////////////////////////////////////\n242: ////////////////////////////////////////////////////////////////////////////////////////////////////\n243: // Read Only Operations\n244: ////////////////////////////////////////////////////////////////////////////////////////////////////\n245: /// ReadonlyState: Tracking the progress of read-only queries\n246: ///\n247: /// Used to track the progress of a read-only queries on the data structure.\n248: ///\n249: /// A readonly query takes place on a given node (`nid`), and follows the following algorithm:\n250: ///\n251: ///  1. Read the global value 'version_upper_bound'.\n252: ///  2. Wait until node-local value 'local_head' is greater than the value\n253: ///     of 'version_upper_bound' that was read in step 1.\n254: ///  3. Execute the query against the node-local replica and return the result.\n255: ///\n256: /// (In real life, the thread does not just sit around 'waiting' in step 2;\n257: /// it might run a combiner phase in order to advance the local_head.)\n258: ///\n259: /// These 3 steps progress the status of the request through the cycle\n260: ///    Init -> VersionUpperBound -> ReadyToRead -> Done\n261: ///\n262: /// Note that the request itself does not \"care\" which nodeId it takes place on;\n263: /// we only track the nodeId to make sure that steps 2 and 3 use the same node.\n264: ///\n265: #[is_variant]\n266: pub ghost enum ReadonlyState<DT: Dispatch> {\n267:     /// a new read request that has come in\n268:     Init { op: DT::ReadOperation },\n269:     /// has read the version upper bound value\n270:     VersionUpperBound { op: DT::ReadOperation, version_upper_bound: LogIdx },\n271:     /// ready to read\n272:     ReadyToRead { op: DT::ReadOperation, version_upper_bound: LogIdx, node_id: NodeId },\n273:     /// read request is done\n274:     Done { op: DT::ReadOperation, version_upper_bound: LogIdx, node_id: NodeId, ret: DT::Response },\n275: }\n276: \n277: impl<DT: Dispatch> ReadonlyState<DT> {\n278:     pub open spec fn op(self) -> DT::ReadOperation {\n279:         match self {\n280:             ReadonlyState::Init { op, .. } => op,\n281:             ReadonlyState::VersionUpperBound { op, .. } => op,\n282:             ReadonlyState::ReadyToRead { op, .. } => op,\n283:             ReadonlyState::Done { op, .. } => op,\n284:         }\n285:     }\n286: }\n287: \n288: ////////////////////////////////////////////////////////////////////////////////////////////////////\n289: // Update Operation\n290: ////////////////////////////////////////////////////////////////////////////////////////////////////\n291: ////////// Updates and the combiner phase\n292: //\n293: // This part is a lot more complex; the lifecycle of an \"update\" is inherently\n294: // tied to the lifecycle of the combiner, so I have to explain the entire combiner\n295: // cycle for this to make sense.\n296: //\n297: // In particular, the combiner cycle starts with some (potentially empty) bulk collection\n298: // of Update requests, which all start in UpdateState::Init.\n299: // By the end of the combiner cycle (when it has gone back to 'Ready'), all the updates\n300: // in that collection will be in UpdateState::Done.\n301: //\n302: // The combiner works as follows (keep in mind this is abstracted a bit from the\n303: // real implementation).\n304: //\n305: //  1. Advance the 'tail' value by 1 for each update in the collection.\n306: //     This creates a \"LogEntry\" for the given op at the given index.\n307: //     It also updates the update from UpdateState::Init to UpdateState::Placed.\n308: //\n309: //      Note: This always appends to the log; there are never any \"holes\" in the log,\n310: //      and the 'tail' always marks the end of the log. The log is unbounded\n311: //      and not garbage-collected.\n312: //      Keep in mind that the 'log' here is just an abstraction, and the \"cyclic buffer\"\n313: //      that physically stores the log entries in real life has additional complexities.\n314: //      We do not handle those complexities at this level of abstraction.\n315: //\n316: //      Note: Even when we have a bulk collection of updates, we still append the log\n317: //      entries one at a time, once for each update. This means the log entries might\n318: //      interleave with those of another thread.\n319: //      This is more permissive than the real implementation, which advances the\n320: //      'tail' with a single CAS operation, meaning that all the log entries\n321: //      for the cycle will be contiguous in the log.\n322: //      In the original Linear Dafny NR project, we modeled this step as a bulk update,\n323: //      matching the implemenation. However, it turned out that:\n324: //          (i) modeling 'bulk update' steps is kind of annoying\n325: //          (ii) we never took advantage of the contiguity in the invariants\n326: //      Since the single-step version is easier to model, and we don't lose anything for it,\n327: //      that's what we do here.\n328: //\n329: //  2. Read the 'local_head' value for the given node.\n330: //\n331: //  3. Read the global 'tail' value.\n332: //\n333: //  4. Process all log entries in the range local_head..tail.\n334: //     (This should include both the log entries we just creates, plus maybe some other\n335: //     log entries from other nodes.)\n336: //\n337: //      NOTE: the global 'tail' value might change over the course of execution,\n338: //      but we're going to stick with the local copy that we just read\n339: //      (i.e., the value on the stack).\n340: //\n341: //     To process a log entry, we first apply the operation to the replica, and get\n342: //     back a \"return value\". Next, we check if the log entry is for the given nodeId,\n343: //     classifying it as \"remote\" or \"local\".\n344: //      - If it's remote, we're done.\n345: //      - If it's local, then we find the Update object in our bulk collection, and\n346: //        update it from UpdateState::Placed to UpdateState::Applied, recording the\n347: //        return value.\n348: //\n349: //  5. Update the global value of 'version_upper_bound'.\n350: //     This step lets us move all the updates to UpdateState::Done.\n351: //\n352: //  6. Update the value of 'local_head'.\n353: //\n354: // Now, there are a bunch of things we need to prove so that the whole thing makes sense\n355: // and so that the implementation can actually follow along and return data to the clients.\n356: //\n357: // Specifically, we have a sequence of \"return ids\" (recorded in the 'queued_ops' field)\n358: // that need to get processed. When the implementation handles a \"local\" operation off the\n359: // log, it appends the return value into a buffer; when it's done, it expects the buffer\n360: // of return values to line up with all the update requests that it started with.\n361: //\n362: // What this means is that we need to show:\n363: //   - When we process a \"local\" operation, its ReqId corresponds to the next\n364: //     ReqId recorded in the queued_ops (i.e., the one at 'queue_index'.)\n365: //   - When we have finished the entire loop, we have finished processing all\n366: //     the ReqIds we expected (i.e., `queue_index == queued_ops.len()`).\n367: //\n368: // This means we need to establish an invariant between the combiner state and the\n369: // log state at all times. Specifically, we need an invariant that relates the combiner\n370: // state to the log entries whose node_ids match the combiner's node, describing where\n371: // they are and in what order.\n372: //\n373: // The invariant roughly says that during step (4), (the \"Loop\" state):\n374: //   The ReqIds in `queued_ops`, sliced from queue_index .. queued_ops.len()\n375: //   match\n376: //   The ReqIds in the log that are local, sliced from\n377: //          local_head .. tail\n378: // (Note that queue_index and local_head are the cursors that advance throughout the loop,\n379: // while tail is the one recorded in step 3, so it's fixed.)\n380: // Furthermore:\n381: //   There are no local operations in the log between\n382: //   the recorded tail and the global tail.\n383: // See the invariant `wf_combiner_for_node_id`, as well as the predicates\n384: // `LogRangeMatchesQueue` and `LogRangeNoNodeId`.\n385: //\n386: // Example: suppose N is the local node_id, and [a, b, c, d] are the request ids.\n387: // We might be in a state that looks like this: (Here, '...' indicates remote entries,\n388: // and '(N, x)' means a log entry with node id N that corresponds to request id x.)\n389: //\n390: //       CombinerState                                           CombinerState   global\n391: //       local_head                                              tail     tail\n392: //          |                                                              |               |\n393: //       ===================================================================================\n394: //          |          |       |       |        |       |          |       |       |       |\n395: //  Log:    |  (N, b)  |  ...  |  ...  | (N, c) |  ...  |  (N, d)  |  ...  |  ...  |  ...  |\n396: //          |          |       |       |        |       |          |       |       |       |\n397: //       ===================================================================================\n398: //\n399: //  ---- Combiner state (in `CombinerState::Loop` phase).\n400: //\n401: //      queued_ops =  [  a,   b,   c,   d   ]\n402: //                          ^\n403: //                          |\n404: //                  queue_index = 1\n405: //\n406: // ---- Update state:\n407: //\n408: //    a => UpdateState::Applied { ... }\n409: //    b => UpdateState::Placed { ... }\n410: //    c => UpdateState::Placed { ... }\n411: //    d => UpdateState::Placed { ... }\n412: //\n413: // In the example, `LogRangeMatchesQueue` is the relation that shows that (b, c, d)\n414: // agree between the queued_ops and the log; whereas `LogRangeNoNodeId` shows that there\n415: // are no more local entries between the Combiner tail and the global tail.\n416: //\n417: // And again, in the real implementation, b, c, d will actually be contiguous in the log,\n418: // but the state shown above is permitted by the model here.\n419: // If we _were_ going to make use of contiguity, then the place to do it would probably\n420: // be the definition of `LogRangeMatchesQueue`, but as I explained earlier, I didn't\n421: // find it helpful.\n422: //\n423: // Another technical note: the LogEntry doesn't actually store the ReqId on it;\n424: // `LogRangeMatchesQueue` has to connect the request id to the UpdateState, which then\n425: // has a pointer into the log via `idx`. (It's possible that this could be simplified.)\n426: #[is_variant]\n427: pub ghost enum UpdateState<DT: Dispatch> {\n428:     /// upated request has entered the system\n429:     Init { op: DT::WriteOperation },\n430:     /// update has been placed into the log\n431:     Placed { op: DT::WriteOperation, idx: LogIdx },\n432:     /// the update has been applied to the data structure\n433:     Applied { ret: DT::Response, idx: LogIdx },\n434:     /// the update is ready to be returned\n435:     Done { ret: DT::Response, idx: LogIdx },\n436: }\n437: \n438: #[is_variant]\n439: pub ghost enum CombinerState {\n440:     Ready,\n441:     Placed { queued_ops: Seq<ReqId> },\n442:     LoadedLocalVersion { queued_ops: Seq<ReqId>, lversion: LogIdx },\n443:     Loop {\n444:         /// sequence of request ids of the local node\n445:         queued_ops: Seq<ReqId>,\n446:         /// version of the local replica\n447:         lversion: LogIdx,\n448:         /// index into the queued ops\n449:         idx: nat,\n450:         /// the global tail we'v read\n451:         tail: LogIdx,\n452:     },\n453:     UpdatedVersion { queued_ops: Seq<ReqId>, tail: LogIdx },\n454: }\n455: \n456: impl CombinerState {\n457:     pub open spec fn queued_ops(self) -> Seq<ReqId> {\n458:         match self {\n459:             CombinerState::Ready => Seq::empty(),\n460:             CombinerState::Placed { queued_ops } => queued_ops,\n461:             CombinerState::LoadedLocalVersion { queued_ops, .. } => queued_ops,\n462:             CombinerState::Loop { queued_ops, .. } => queued_ops,\n463:             CombinerState::UpdatedVersion { queued_ops, .. } => queued_ops,\n464:         }\n465:     }\n466: \n467:     pub open spec fn queued_ops_set(&self) -> Set<ReqId> {\n468:         seq_to_set(self.queued_ops())\n469:     }\n470: }\n471: \n472: } // verus!\n473: // end verus!\n474: tokenized_state_machine! {\n475: UnboundedLog<DT: Dispatch> {\n476:     fields {\n477:         /// the number of replicas\n478:         #[sharding(constant)]\n479:         pub num_replicas: nat,\n480: \n481:         #[sharding(map)]\n482:         pub log: Map<LogIdx, LogEntry<DT>>,\n483: \n484:         #[sharding(variable)]\n485:         pub tail: nat,\n486: \n487:         #[sharding(map)]\n488:         pub replicas: Map<NodeId, DT::View>,\n489: \n490:         #[sharding(map)]\n491:         pub local_versions: Map<NodeId, LogIdx>, // previously called \"local tails\"\n492: \n493:         #[sharding(variable)]\n494:         pub version_upper_bound: LogIdx, // previously called \"ctail\"\n495: \n496:         #[sharding(map)]\n497:         pub local_reads: Map<ReqId, ReadonlyState<DT>>,\n498: \n499:         #[sharding(map)]\n500:         pub local_updates: Map<ReqId, UpdateState<DT>>,\n501: \n502:         #[sharding(map)]\n503:         pub combiner: Map<NodeId, CombinerState>\n504:     }\n505: \n506: \n507:     ////////////////////////////////////////////////////////////////////////////////////////////\n508:     // Invariant\n509:     ////////////////////////////////////////////////////////////////////////////////////////////\n510: \n511:     #[invariant]\n512:     pub fn inv_request_ids_finite(&self) -> bool {\n513:         &&& self.local_reads.dom().finite()\n514:         &&& self.local_updates.dom().finite()\n515:         &&& self.combiner.dom().finite()\n516:     }\n517: \n518:     // /// there must be a replicat for all nodes\n519:     // #[invariant]\n520:     // pub fn inv_replicas_complete(&self) -> bool {\n521:     //     forall |node_id: NodeId| 0 <= node_id < self.num_replicas <==>\n522:     //         self.replicas.contains_key(node_id)\n523:     // }\n524: \n525:     // /// ther emust be a local version for all nodes\n526:     // #[invariant]\n527:     // pub fn inv_local_versions_complete(&self) -> bool {\n528:     //     forall |node_id: NodeId| 0 <= node_id < self.num_replicas <==>\n529:     //         self.local_versions.contains_key(node_id)\n530:     // }\n531: \n532:     /// there must be a combiner for all node\n533:     #[invariant]\n534:     pub fn inv_local_combiner_complete(&self) -> bool {\n535:         forall |node_id: NodeId| 0 <= node_id < self.num_replicas <==>\n536:             self.combiner.contains_key(node_id)\n537:     }\n538: \n539:     #[invariant]\n540:     pub fn combiner_local_versions_domains(&self) -> bool {\n541:         forall |k| self.local_versions.contains_key(k) <==> self.combiner.contains_key(k)\n542:     }\n543: \n544:     #[invariant]\n545:     pub fn combiner_replicas_domains(&self) -> bool {\n546:         forall |k| #![auto] self.replicas.contains_key(k) <==> self.combiner.contains_key(k)\n547:     }\n548: \n549:     pub open spec fn wf_node_id(&self, node_id: NodeId) -> bool {\n550:         &&& 0 <= node_id < self.num_replicas\n551:         &&& self.combiner.contains_key(node_id)\n552:         &&& self.local_versions.contains_key(node_id)\n553:         &&& self.replicas.contains_key(node_id)\n554:     }\n555: \n556: \n557:     // #[invariant]\n558:     // pub fn inv_queued_ops_in_local_updates(&self) -> bool {\n559:     //     forall |node_id, rid|\n560:     //         (#[trigger] self.combiner.contains_key(node_id) && !(#[trigger] self.local_updates.contains_key(rid)))\n561:     //             ==> !self.combiner[node_id].queued_ops().contains(rid)\n562:     // }\n563: \n564: \n565: \n566:     // && Inv_WF(s)\n567:     // && Inv_GlobalTailCompleteTailOrdering(s)\n568: \n569:     /// the version upper bound must be smaller or equal to the global tail\n570:     /// Inv_GlobalTailCompleteTailOrdering\n571:     #[invariant]\n572:     pub fn inv_version_in_range(&self) -> bool {\n573:         self.version_upper_bound <= self.tail\n574:     }\n575: \n576: \n577:     /// all local versions are less or equal to the version upper bound\n578:     /// Inv_CompletedTailLowerBound && Inv_GlobalTailLowerBound(s)\n579:     #[invariant]\n580:     pub fn inv_local_version_upper_bound_heads(&self) -> bool {\n581:         forall |node_id| (#[trigger]  self.local_versions.contains_key(node_id))\n582:             ==> self.local_versions[node_id] <= self.version_upper_bound\n583:     }\n584: \n585: \n586:     /// The read request states are valid\n587:     /// Inv_ReadRequest_WF(s) && Inv_ReadOnlyCtailsCompleteTailOrdering(s) && Inv_ReadOnlyStateNodeIdExists(s)\n588:     #[invariant]\n589:     pub fn inv_readonly_requests_wf(&self) -> bool {\n590:         forall |rid| (#[trigger] self.local_reads.contains_key(rid))\n591:              ==> self.wf_readstate(self.local_reads[rid])\n592:     }\n593: \n594:     pub open spec fn wf_readstate(&self, rs: ReadonlyState<DT>) -> bool {\n595:         match rs {\n596:             ReadonlyState::Init{op} => {\n597:                 true\n598:             }\n599:             ReadonlyState::VersionUpperBound{op, version_upper_bound} => {\n600:                 version_upper_bound <= self.version_upper_bound\n601:             }\n602:             ReadonlyState::ReadyToRead{op, node_id, version_upper_bound} => {\n603:                 &&& self.wf_node_id(node_id)\n604:                 &&& version_upper_bound <= self.version_upper_bound\n605:                 &&& version_upper_bound <= self.current_local_version(node_id)\n606:             }\n607:             ReadonlyState::Done{op, ret, node_id, version_upper_bound } => {\n608:                 &&& self.wf_node_id(node_id)\n609:                 &&& version_upper_bound <= self.version_upper_bound\n610:                 &&& version_upper_bound <= self.current_local_version(node_id)\n611:             }\n612:         }\n613:     }\n614: \n615: \n616:     /// the combiner states are wellformed\n617:     /// Inv_CombinerStateValid(s)\n618:     #[invariant]\n619:     pub open spec fn combiner_states_wf(&self) -> bool {\n620:         forall |node_id| (#[trigger] self.combiner.contains_key(node_id))\n621:              ==> self.wf_combiner_for_node_id(node_id)\n622:     }\n623: \n624:     pub open spec fn wf_combiner_for_node_id(&self, node_id: NodeId) -> bool\n625:         recommends self.wf_node_id(node_id)\n626:     {\n627:         match self.combiner[node_id] {\n628:             CombinerState::Ready => {\n629:                 // from other inv\n630:                 // &&& self.local_versions.contains_key(node_id)\n631:                 // &&& self.local_versions[node_id] <= self.tail\n632:                 &&& LogRangeNoNodeId(self.log, self.local_versions[node_id], self.tail, node_id)\n633:             }\n634:             CombinerState::Placed { queued_ops } => {\n635:                 // &&& self.local_versions.contains_key(node_id)\n636:                 // &&& self.local_versions[node_id] <= self.tail\n637:                 &&& LogRangeMatchesQueue(queued_ops, self.log, 0, self.local_versions[node_id], self.tail, node_id, self.local_updates)\n638:                 &&& QueueRidsUpdatePlaced(queued_ops, self.local_updates, 0)\n639:                 &&& seq_unique(queued_ops)\n640:             }\n641:             CombinerState::LoadedLocalVersion{ queued_ops, lversion } => {\n642:                // we've just read the local tail value, and no-one else should modify that\n643:                 &&& lversion == self.local_versions[node_id]\n644:                 // by transitivity we have lversion <= self.version_upper_bound and self.tail\n645:                 // the local tail should be smaller or equal than the ctail\n646:                 // &&& lversion <= self.version_upper_bound\n647:                 // &&& lversion <= self.tail\n648:                 &&& LogRangeMatchesQueue(queued_ops, self.log, 0, lversion, self.tail, node_id, self.local_updates)\n649:                 &&& QueueRidsUpdatePlaced(queued_ops, self.local_updates, 0)\n650:                 &&& seq_unique(queued_ops)\n651:             }\n652:             CombinerState::Loop{ queued_ops, idx, lversion, tail } => {\n653:                 // the global tail may have already advanced...\n654:                 &&& tail <= self.tail\n655:                 // we're advancing the local tail here\n656:                 &&& lversion >= self.local_versions[node_id]\n657:                 // the local tail should always be smaller or equal to the global tail\n658:                 &&& lversion <= tail\n659:                 // the log now contains all entries up to localtail\n660:                 &&& LogContainsEntriesUpToHere(self.log, lversion)\n661:                 &&& 0 <= idx <= queued_ops.len()\n662:                 &&& LogRangeMatchesQueue(queued_ops, self.log, idx, lversion, tail, node_id, self.local_updates)\n663:                 &&& LogRangeNoNodeId(self.log, tail, self.tail, node_id)\n664:                 &&& QueueRidsUpdatePlaced(queued_ops, self.local_updates, idx)\n665:                 &&& QueueRidsUpdateDone(queued_ops, self.local_updates, idx)\n666:                 &&& seq_unique(queued_ops)\n667:             }\n668:             CombinerState::UpdatedVersion{ queued_ops, tail } => {\n669:                 // the global tail may have already advanced...\n670:                 // tail <= self.tail // by transitivity: self.version_upper_bound <= self.tail\n671:                 // update the ctail value\n672:                 &&& tail <= self.version_upper_bound\n673:                 // the local tail should be smaller than this one here\n674:                 &&& self.local_versions[node_id] <= tail\n675:                 // the log now contains all entries up to tail\n676:                 &&& LogContainsEntriesUpToHere(self.log, tail)\n677:                 &&& LogRangeNoNodeId(self.log, tail, self.tail, node_id)\n678:                 &&& QueueRidsUpdateDone(queued_ops, self.local_updates, queued_ops.len())\n679:                 &&& seq_unique(queued_ops)\n680:             }\n681:         }\n682:     }\n683: \n684: \n685:     /// the log contains entries up to the global tail\n686:     /// Inv_LogEntriesGlobalTail(s)\n687:     ///\n688:     /// Inv_LogEntriesUpToCTailExists(s) && Inv_LogEntriesUpToLocalTailExist(s) are implied\n689:     #[invariant]\n690:     pub fn inv_log_complete(&self) -> bool {\n691:         &&& LogContainsEntriesUpToHere(self.log, self.tail)\n692:         &&& LogNoEntriesFromHere(self.log, self.tail)\n693:     }\n694: \n695: \n696:     /// Wellformed local update state\n697:     /// Inv_LocalUpdatesIdx(s)\n698:     #[invariant]\n699:     pub fn inv_local_updates(&self) -> bool {\n700:         forall |rid| (#[trigger] self.local_updates.contains_key(rid))\n701:             ==>  self.inv_local_updates_wf(self.local_updates[rid])\n702:     }\n703: \n704:     pub open spec fn inv_local_updates_wf(&self, update: UpdateState<DT>) -> bool {\n705:         match update {\n706:             UpdateState::Init { op } => { true },\n707:             UpdateState::Placed { op: _, idx } => {\n708:                 &&& self.log.contains_key(idx)\n709:                 &&& idx < self.tail\n710:             },\n711:             UpdateState::Applied { ret, idx } => {\n712:                 &&& self.log.contains_key(idx)\n713:                 &&& idx < self.tail\n714:             },\n715:             UpdateState::Done { ret, idx } => {\n716:                 &&& self.log.contains_key(idx)\n717:                 &&& idx < self.version_upper_bound\n718:             },\n719:         }\n720:     }\n721: \n722: \n723:     /// The results of the read operation must match\n724:     /// Inv_ReadOnlyResult(s)\n725:     #[invariant]\n726:     pub fn inv_read_results(&self) -> bool {\n727:         forall |rid| (#[trigger] self.local_reads.contains_key(rid))\n728:              ==>  self.read_results_match(self.local_reads[rid])\n729:     }\n730: \n731:     pub open spec fn read_results_match(&self, read: ReadonlyState<DT>) -> bool {\n732:         match read {\n733:             ReadonlyState::Done { ret, version_upper_bound, op, .. } => {\n734:                 exists |v: nat| (#[trigger] rangeincl(version_upper_bound, v, self.version_upper_bound))\n735:                     && ret == DT::dispatch_spec(compute_nrstate_at_version(self.log, v), op)\n736:             },\n737:             _ => true,\n738:         }\n739:     }\n740: \n741: \n742:     /// The results of the updates must match\n743:     /// Inv_UpdateResults(s)\n744:     #[invariant]\n745:     pub fn inv_update_results(&self) -> bool {\n746:         forall |rid| (#[trigger] self.local_updates.contains_key(rid))\n747:             ==>  self.update_results_match(self.local_updates[rid])\n748:     }\n749: \n750:     pub open spec fn update_results_match(&self, update: UpdateState<DT>) -> bool {\n751:         match update {\n752:             UpdateState::Applied { ret, idx } => {\n753:                 ret == DT::dispatch_mut_spec(compute_nrstate_at_version(self.log, idx), self.log[idx].op).1\n754:             },\n755:             UpdateState::Done { ret, idx } => {\n756:                 ret == DT::dispatch_mut_spec(compute_nrstate_at_version(self.log, idx), self.log[idx].op).1\n757:             },\n758:             _ => true,\n759:         }\n760:     }\n761: \n762: \n763:     /// All combiners must have distinct request ids they are working on\n764:     /// Inv_CombinerRidsDistinct(s)\n765:     #[invariant]\n766:     pub fn inv_combiner_rids_distinct(&self) -> bool\n767:     {\n768:       forall |node_id1, node_id2|\n769:           (#[trigger] self.combiner.contains_key(node_id1)\n770:           && #[trigger] self.combiner.contains_key(node_id2)\n771:           && node_id1 != node_id2) ==>\n772:             seq_disjoint(self.combiner[node_id1].queued_ops(), self.combiner[node_id2].queued_ops())\n773:     }\n774: \n775: \n776:     /// the state of the replica must match the current version of the log\n777:     #[invariant]\n778:     pub open spec fn replica_state(&self) -> bool {\n779:         forall |node_id| (#[trigger] self.replicas.contains_key(node_id)) ==>\n780:             self.replicas[node_id] == compute_nrstate_at_version(self.log, self.current_local_version(node_id))\n781:     }\n782: \n783: \n784:     ////////////////////////////////////////////////////////////////////////////////////////////\n785:     // State Machine Initialization\n786:     ////////////////////////////////////////////////////////////////////////////////////////////\n787: \n788:     init!{\n789:         initialize(number_of_nodes: nat) {\n790:             require(number_of_nodes > 0);\n791: \n792:             init num_replicas = number_of_nodes;\n793:             init log = Map::empty();\n794:             init tail = 0;\n795:             init replicas = Map::new(Set::range(0, number_of_nodes), |n| DT::init_spec());\n796:             init local_versions = Map::new(Set::range(0, number_of_nodes), |n| 0);\n797:             init version_upper_bound = 0;\n798:             init local_reads = Map::empty();\n799:             init local_updates = Map::empty();\n800:             init combiner = Map::new(Set::range(0, number_of_nodes), |n| CombinerState::Ready);\n801:         }\n802:     }\n803: \n804:     ////////////////////////////////////////////////////////////////////////////////////////////\n805:     // Readonly Transitions\n806:     ////////////////////////////////////////////////////////////////////////////////////////////\n807: \n808:     /// Read Request: Read the version of the log\n809:     ///\n810:     /// The algorithm waits while local_version < read_version\n811:     transition!{\n812:         readonly_version_upper_bound(rid: ReqId) {\n813:             remove local_reads -= [ rid => let ReadonlyState::Init { op } ];\n814:             add    local_reads += [ rid => ReadonlyState::VersionUpperBound {\n815:                                                 op, version_upper_bound: pre.version_upper_bound } ];\n816:         }\n817:     }\n818: \n819:     /// Read Request: wait until the version of the state has reached the version of the log\n820:     ///\n821:     /// The algorithm waits while local_version < read_version\n822:     transition!{\n823:         readonly_ready_to_read(rid: ReqId, node_id: NodeId) {\n824:             remove local_reads    -= [ rid => let ReadonlyState::VersionUpperBound { op, version_upper_bound } ];\n825:             have   local_versions >= [ node_id => let local_head ];\n826: \n827:             require(local_head >= version_upper_bound);\n828: \n829:             add local_reads += [ rid => ReadonlyState::ReadyToRead{op, node_id, version_upper_bound} ];\n830:         }\n831:     }\n832: \n833:     /// Read Request: perform the read request on the local replica, the combiner must not be busy\n834:     transition!{\n835:         readonly_apply(rid: ReqId) {\n836:             remove local_reads -= [ rid => let ReadonlyState::ReadyToRead { op, node_id, version_upper_bound } ];\n837:             have   combiner    >= [ node_id => CombinerState::Ready ];\n838:             have   replicas    >= [ node_id => let state ];\n839: \n840:             let ret = DT::dispatch_spec(state, op);\n841: \n842:             add local_reads += [ rid => ReadonlyState::Done{ op, node_id, version_upper_bound, ret } ];\n843:         }\n844:     }\n845: \n846:     ////////////////////////////////////////////////////////////////////////////////////////////\n847:     // Update Transitions\n848:     ////////////////////////////////////////////////////////////////////////////////////////////\n849: \n850:     /// Combiner: Collect the operations and place them into the log\n851:     transition!{\n852:         update_place_ops_in_log_one(node_id: NodeId, rid: ReqId) {\n853:             // Only allowing a single request at a time\n854:             // (in contrast to the seagull one which does it in bulk).\n855:             // Hopefully this leads to some easier proofs.\n856:             remove combiner      -= [ node_id => let CombinerState::Placed{ queued_ops } ];\n857:             remove local_updates -= [ rid => let UpdateState::Init{ op }];\n858: \n859:             update tail = pre.tail + 1;\n860:             add log           += [ pre.tail => LogEntry{ op, node_id }];\n861:             add local_updates += [ rid => UpdateState::Placed{ op, idx: pre.tail }];\n862:             add combiner      += [ node_id => CombinerState::Placed { queued_ops: queued_ops.push(rid) } ];\n863:         }\n864:     }\n865: \n866:     transition!{\n867:         update_done(rid:ReqId) {\n868:             remove local_updates -= [ rid => let UpdateState::Applied { ret, idx } ];\n869: \n870:             // we must have applied the\n871:             require(pre.version_upper_bound > idx);\n872: \n873:             add local_updates += [ rid => UpdateState::Done { ret, idx } ];\n874:         }\n875:     }\n876: \n877:     /*/// Update: Remove a finished update from the system\n878:     transition!{\n879:         update_finish(rid:ReqId) {\n880:             remove local_updates -= [ rid => let UpdateState::Done { ret, idx } ];\n881:         }\n882:     }*/\n883: \n884: \n885:     ////////////////////////////////////////////////////////////////////////////////////////////\n886:     // Combiner Execute Transitions\n887:     ////////////////////////////////////////////////////////////////////////////////////////////\n888: \n889: \n890:     /// Combiner: start the combiner to execute the update operations on the local replica\n891:     transition!{\n892:         exec_trivial_start(node_id: NodeId) {\n893:             remove combiner -= [ node_id => CombinerState::Ready ];\n894: \n895:             add    combiner += [ node_id => CombinerState::Placed { queued_ops: Seq::empty() } ];\n896:         }\n897:     }\n898: \n899:     /// Combiner: read the version of the local replica\n900:     transition!{\n901:         exec_load_local_version(node_id: NodeId) {\n902:             remove combiner      -= [ node_id => let CombinerState::Placed { queued_ops } ];\n903: \n904:             have   local_versions >= [node_id => let lversion];\n905: \n906:             add    combiner      += [ node_id => CombinerState::LoadedLocalVersion { queued_ops, lversion }];\n907:         }\n908:     }\n909: \n910:     /// Combiner: read the global tail\n911:     transition!{\n912:         exec_load_global_head(node_id: NodeId) {\n913:             remove combiner -= [ node_id => let CombinerState::LoadedLocalVersion { queued_ops, lversion } ];\n914: \n915:             add    combiner += [ node_id => CombinerState::Loop { queued_ops, lversion, idx: 0, tail: pre.tail } ];\n916:         }\n917:     }\n918: \n919:     /// Combiner: Safety condition, the queue index must be within bounds\n92