eserved because\n+    // local_updates only changed in one entry\n+    \n+    // The update_results_match invariant:\n+    assert forall |r| #[trigger] post.local_updates.contains_key(r) implies post.update_results_match(post.local_updates[r]) by {\n+        if r == rid {\n+            // For the changed entry from Applied to Done, the result should be the same\n+            let UpdateState::Done { ret, idx } = post.local_updates[r];\n+            assert(ret == DT::dispatch_mut_spec(compute_nrstate_at_version(post.log, idx), post.log[idx].op).1);\n+        } else {\n+            // For unchanged entries, the invariant is preserved from pre\n+            assert(post.update_results_match(post.local_updates[r]));\n+        }\n+    }\n+    \n+    // For combiner-related invariants, we need to show that changing one local_updates entry\n+    // from Applied to Done preserves the well-formedness conditions\n+    assert forall |node_id| #[trigger] post.combiner.contains_key(node_id) implies post.wf_combiner_for_node_id(node_id) by {\n+        // The combiner state itself hasn't changed, only local_updates changed for one rid\n+        // We need to check that LogRangeMatchesQueue and related predicates are preserved\n+        match post.combiner[node_id] {\n+            CombinerState::Placed { queued_ops } => {\n+                // Uses LogRangeMatchesQueue with idx=0\n+                // Uses QueueRidsUpdatePlaced with idx=0 and QueueRidsUpdateDone with idx=0\n+                // Since our rid may or may not be in queued_ops, we need to check both cases\n+                if queued_ops.contains(rid) {\n+                    // The lemmas like LogRangeMatchesQueue_update_change should handle this\n+                    LogRangeMatchesQueue_update_change(queued_ops, post.log, 0, post.local_versions[node_id], post.tail, node_id, pre.local_updates, post.local_updates);\n+                    QueueRidsUpdatePlaced_update_change(queued_ops, pre.local_updates, post.local_updates, 0);\n+                } else {\n+                    // No change to the queue, so no change to the properties\n+                }\n+            }\n+            CombinerState::LoadedLocalVersion{ queued_ops, lversion } => {\n+                if queued_ops.contains(rid) {\n+                    LogRangeMatchesQueue_update_change(queued_ops, post.log, 0, lversion, post.tail, node_id, pre.local_updates, post.local_updates);\n+                    QueueRidsUpdatePlaced_update_change(queued_ops, pre.local_updates, post.local_updates, 0);\n+                }\n+            }\n+            CombinerState::Loop{ queued_ops, idx, lversion, tail } => {\n+                if queued_ops.contains(rid) {\n+                    if idx <= queued_ops.index_of(rid) {\n+                        LogRangeMatchesQueue_update_change(queued_ops, post.log, idx, lversion, tail, node_id, pre.local_updates, post.local_updates);\n+                        QueueRidsUpdatePlaced_update_change_idx(queued_ops, pre.local_updates, post.local_updates, idx);\n+                        QueueRidsUpdateDone_update_change_idx(queued_ops, pre.local_updates, post.local_updates, idx);\n+                    }\n+                }\n+            }\n+            CombinerState::UpdatedVersion{ queued_ops, tail } => {\n+                if queued_ops.contains(rid) {\n+                    // For UpdatedVersion, we check QueueRidsUpdateDone with idx=queued_ops.len()\n+                    QueueRidsUpdateDone_update_change_full(queued_ops, pre.local_updates, post.local_updates);\n+                }\n+            }\n+            _ => {}\n+        }\n+    }\n+}\n \n pub proof fn consume_stub_inductive(\n     pre: UnboundedLog::State<DT>,\n     post: UnboundedLog::State<DT>,\n","additions":92,"deletions":1},"truncated":false},"title":"workspace/task_env/unbounded_log_update_done_inductive.rs","time":{"start":1786535553045,"end":1786535553059}},"id":"prt_ff5d0f047001pt4QHfVcNSFaox","sessionID":"ses_00a2fb73cffed5ljql9MLVWUSK","messageI