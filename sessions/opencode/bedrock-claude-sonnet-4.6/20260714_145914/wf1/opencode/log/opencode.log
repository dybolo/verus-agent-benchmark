timestamp=2026-07-14T14:01:32.754Z level=INFO run=6893a30b message=evaluated permission=bash pattern="cat > /tmp/wf1_test2.rs << 'EOF'\nuse vstd::prelude::*;\n\nfn main() {}\n\nverus!{\n\npub type StatePred<T> = spec_fn(T) -> bool;\n\npub type ActionPred<T> = spec_fn(T, T) -> bool;\n\n\n// File: defs.rs\npub struct Execution<T> {\n    pub nat_to_state: spec_fn(nat) -> T,\n}\n\nimpl<T> Execution<T> {\n\n    pub open spec fn head(self) -> T {\n        (self.nat_to_state)(0)\n    }\n\n    pub open spec fn head_next(self) -> T {\n        (self.nat_to_state)(1)\n    }\n\n    pub open spec fn suffix(self, pos: nat) -> Self {\n        Execution {\n            nat_to_state: |i: nat| (self.nat_to_state)(i + pos),\n        }\n    }\n\n}\n\n\n#[verifier(reject_recursive_types(T))]\npub struct TempPred<T> {\n    pub pred: spec_fn(Execution<T>) -> bool,\n}\n\nimpl<T> TempPred<T> {\n\n    pub open spec fn new(pred: spec_fn(Execution<T>) -> bool) -> Self {\n        TempPred {\n            pred: pred,\n        }\n    }\n\n    pub open spec fn satisfied_by(self, execution: Execution<T>) -> bool {\n        (self.pred)(execution)\n    }\n\n    pub open spec fn and(self, other: Self) -> Self {\n        TempPred::new(|ex: Execution<T>| self.satisfied_by(ex) && other.satisfied_by(ex))\n    }\n\n    pub open spec fn or(self, other: Self) -> Self {\n        TempPred::new(|ex: Execution<T>| self.satisfied_by(ex) || other.satisfied_by(ex))\n    }\n\n    pub open spec fn implies(self, other: Self) -> Self {\n        TempPred::new(|ex: Execution<T>| self.satisfied_by(ex) ==> other.satisfied_by(ex))\n    }\n\n    pub open spec fn leads_to(self, other: Self) -> Self {\n        always(self.implies(eventually(other)))\n    }\n\n    pub open spec fn entails(self, other: Self) -> bool {\n        valid(self.implies(other))\n    }\n\n}\n\n\npub open spec fn lift_state<T>(state_pred: StatePred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| state_pred(ex.head()))\n}\n\npub open spec fn lift_action<T>(action_pred: ActionPred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| action_pred(ex.head(), ex.head_next()))\n}\n\npub open spec fn always<T>(temp_pred: TempPred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| forall |i: nat| #[trigger] temp_pred.satisfied_by(ex.suffix(i)))\n}\n\npub open spec fn eventually<T>(temp_pred: TempPred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| exists |i: nat| #[trigger] temp_pred.satisfied_by(ex.suffix(i)))\n}\n\npub open spec fn later<T>(temp_pred: TempPred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| temp_pred.satisfied_by(ex.suffix(1)))\n}\n\npub open spec fn enabled<T>(action_pred: ActionPred<T>) -> StatePred<T> {\n    |s: T| exists |s_prime: T| #[trigger] action_pred(s, s_prime)\n}\n\npub open spec fn weak_fairness<T>(action_pred: ActionPred<T>) -> TempPred<T> {\n    always(lift_state(enabled(action_pred))).leads_to(lift_action(action_pred))\n}\n\npub open spec fn valid<T>(temp_pred: TempPred<T>) -> bool {\n    forall |ex: Execution<T>| temp_pred.satisfied_by(ex)\n}\n\n\n// File: rules.rs\n\t#[verifier::external_body]\nproof fn weak_fairness_unfold<T>(ex: Execution<T>, p: ActionPred<T>)\n    requires weak_fairness(p).satisfied_by(ex),\n    ensures forall |i| always(lift_state(enabled(p))).implies(eventually(lift_action(p))).satisfied_by(#[trigger] ex.suffix(i)),\n\t{\n\t\tunimplemented!()\n\t}\n\n\t#[verifier::external_body]\nproof fn implies_apply<T>(ex: Execution<T>, p: TempPred<T>, q: TempPred<T>)\n    requires\n        p.implies(q).satisfied_by(ex),\n        p.satisfied_by(ex),\n    ensures q.satisfied_by(ex),\n\t{\n\t\tunimplemented!()\n\t}\n\n\t#[verifier::external_body]\nproof fn implies_apply_with_always<T>(ex: Execution<T>, p: TempPred<T>, q: TempPred<T>)\n    requires\n        always(p.implies(q)).satisfied_by(ex),\n        always(p).satisfied_by(ex),\n    ensures always(q).satisfied_by(ex),\n\t{\n\t\tunimplemented!()\n\t}\n\n\t#[verifier::external_body]\npub proof fn execution_equality<T>(ex1: Execution<T>, ex2: Execution<T>)\n    requires forall |i: nat| #[trigger] (ex1.nat_to_state)(i) == (ex2.nat_to_state)(i),\n    ensures ex1 == ex2,\n\t{\n\t\tunimplemented!()\n\t}\n\n\t#[verifier::external_body]\npub proof fn wf1_variant_temp<T>(spec: TempPred<T>, next: TempPred<T>, forward: TempPred<T>, p: TempPred<T>, q: TempPred<T>)\n    requires\n        spec.entails(always(p.and(next).implies(later(p).or(later(q))))),\n        spec.entails(always(p.and(next).and(forward).implies(later(q)))),\n        spec.entails(always(next)),\n        spec.entails(always(p).leads_to(forward)),\n    ensures spec.entails(p.leads_to(q)),\n\t{\n\t\tunimplemented!()\n\t}\n\npub proof fn wf1<T>(spec: TempPred<T>, next: ActionPred<T>, forward: ActionPred<T>, p: StatePred<T>, q: StatePred<T>)\n    requires\n        forall |s, s_prime: T| p(s) && #[trigger] next(s, s_prime) ==> p(s_prime) || q(s_prime),\n        forall |s, s_prime: T| p(s) && #[trigger] next(s, s_prime) && forward(s, s_prime) ==> q(s_prime),\n        forall |s: T| #[trigger] p(s) ==> enabled(forward)(s),\n        spec.entails(always(lift_action(next))),\n        spec.entails(weak_fairness(forward)),\n    ensures spec.entails(lift_state(p).leads_to(lift_state(q))),\n{\n    let p_temp = lift_state(p);\n    let q_temp = lift_state(q);\n    let next_temp = lift_action(next);\n    let forward_temp = lift_action(forward);\n\n    // Prove condition 1: spec.entails(always(p_temp.and(next_temp).implies(later(p_temp).or(later(q_temp)))))\n    assert forall |ex: Execution<T>| spec.satisfied_by(ex) implies\n        always(p_temp.and(next_temp).implies(later(p_temp).or(later(q_temp)))).satisfied_by(ex)\n    by {\n        assert forall |i: nat| #[trigger] p_temp.and(next_temp).implies(later(p_temp).or(later(q_temp))).satisfied_by(ex.suffix(i))\n        by {\n            let ex_i = ex.suffix(i);\n            if p_temp.and(next_temp).satisfied_by(ex_i) {\n                let s = ex_i.head();\n                let s_prime = ex_i.head_next();\n                assert(p(s));\n                assert(next(s, s_prime));\n                assert(p(s_prime) || q(s_prime));\n                // ex_i.suffix(1).head() == s_prime\n                assert(ex_i.suffix(1).head() == s_prime) by {\n                    let ex_i1 = ex_i.suffix(1);\n                    // ex_i1.nat_to_state = |j: nat| (ex_i.nat_to_state)(j + 1)\n                    // ex_i1.head() = (ex_i1.nat_to_state)(0) = (ex_i.nat_to_state)(0 + 1) = (ex_i.nat_to_state)(1) = ex_i.head_next()\n                    assert((ex_i.suffix(1).nat_to_state)(0) == (ex_i.nat_to_state)(0 + 1));\n                };\n                assert(later(p_temp).or(later(q_temp)).satisfied_by(ex_i));\n            }\n        };\n    };\n    assert(spec.entails(always(p_temp.and(next_temp).implies(later(p_temp).or(later(q_temp))))));\n\n    // Prove condition 2: spec.entails(always(p_temp.and(next_temp).and(forward_temp).implies(later(q_temp))))\n    assert forall |ex: Execution<T>| spec.satisfied_by(ex) implies\n        always(p_temp.and(next_temp).and(forward_temp).implies(later(q_temp))).satisfied_by(ex)\n    by {\n        assert forall |i: nat| #[trigger] p_temp.and(next_temp).and(forward_temp).implies(later(q_temp)).satisfied_by(ex.suffix(i))\n        by {\n            let ex_i = ex.suffix(i);\n            if p_temp.and(next_temp).and(forward_temp).satisfied_by(ex_i) {\n                let s = ex_i.head();\n                let s_prime = ex_i.head_next();\n                assert(p(s));\n                assert(next(s, s_prime));\n                assert(forward(s, s_prime));\n                assert(q(s_prime));\n                assert(ex_i.suffix(1).head() == s_prime) by {\n                    assert((ex_i.suffix(1).nat_to_state)(0) == (ex_i.nat_to_state)(0 + 1));\n                };\n                assert(later(q_temp).satisfied_by(ex_i));\n            }\n        };\n    };\n    assert(spec.entails(always(p_temp.and(next_temp).and(forward_temp).implies(later(q_temp)))));\n\n    // Condition 3 is directly given\n    assert(spec.entails(always(next_temp)));\n\n    // Prove condition 4: spec.entails(always(p_temp).leads_to(forward_temp))\n    // = spec.entails(always(always(p_temp).implies(eventually(forward_temp))))\n    assert forall |ex: Execution<T>| spec.satisfied_by(ex) implies\n        always(always(p_temp).implies(eventually(forward_temp))).satisfied_by(ex)\n    by {\n        assert(weak_fairness(forward).satisfied_by(ex));\n        weak_fairness_unfold(ex, forward);\n        // Now we have: forall i, always(lift_state(enabled(forward))).implies(eventually(lift_action(forward))).satisfied_by(ex.suffix(i))\n        assert forall |i: nat| #[trigger] always(p_temp).implies(eventually(forward_temp)).satisfied_by(ex.suffix(i))\n        by {\n            let ex_i = ex.suffix(i);\n            if always(p_temp).satisfied_by(ex_i) {\n                // Show always(lift_state(enabled(forward))) holds at ex_i\n                assert(always(lift_state(enabled(forward))).satisfied_by(ex_i)) by {\n                    assert forall |j: nat| #[trigger] lift_state(enabled(forward)).satisfied_by(ex_i.suffix(j))\n                    by {\n                        // p_temp holds at ex_i.suffix(j) since always(p_temp) holds at ex_i\n                        assert(p_temp.satisfied_by(ex_i.suffix(j)));\n                        let s = ex_i.suffix(j).head();\n                        assert(p(s));\n                        assert(enabled(forward)(s));\n                        assert(lift_state(enabled(forward)).satisfied_by(ex_i.suffix(j)));\n                    };\n                };\n                // Now apply: always(lift_state(enabled(forward))).implies(eventually(lift_action(forward))).satisfied_by(ex_i)\n                implies_apply(ex_i, always(lift_state(enabled(forward))), eventually(lift_action(forward)));\n                assert(eventually(forward_temp).satisfied_by(ex_i));\n            }\n        };\n    };\n    assert(spec.entails(always(p_temp).leads_to(forward_temp)));\n\n    // Apply wf1_variant_temp\n    wf1_variant_temp(spec, next_temp, forward_temp, p_temp, q_temp);\n}\n\n\n}\nEOF" action.permission=* action.action=allow action.pattern=*
