timestamp=2026-07-14T14:14:25.981Z level=INFO run=36866cb2 message=evaluated permission=bash pattern="cat > /tmp/test_api_server.rs << 'EOF'\nuse vstd::prelude::*;\nuse vstd::multiset::Multiset;\nuse verus_builtin::*;\nuse verus_builtin_macros::*;\n\nfn main() {}\n\nverus! {\n\n// Minimal types needed\npub type StringView = Seq<char>;\npub type ResourceVersion = int;\npub type Uid = int;\npub type Value = StringView;\n\n#[is_variant]\npub enum Kind {\n    PodKind,\n    CustomResourceKind(StringView),\n}\n\npub struct ObjectRef {\n    pub kind: Kind,\n    pub name: StringView,\n    pub namespace: StringView,\n}\n\npub struct ObjectMetaView {\n    pub name: Option<StringView>,\n    pub namespace: Option<StringView>,\n    pub resource_version: Option<ResourceVersion>,\n    pub uid: Option<Uid>,\n    pub owner_references: Option<Seq<()>>,\n    pub deletion_timestamp: Option<StringView>,\n    pub finalizers: Option<Seq<StringView>>,\n    pub generate_name: Option<StringView>,\n    pub labels: Option<Map<StringView, StringView>>,\n    pub annotations: Option<Map<StringView, StringView>>,\n}\n\nimpl ObjectMetaView {\n    pub open spec fn well_formed_for_namespaced(self) -> bool {\n        self.name is Some && self.namespace is Some && self.resource_version is Some && self.uid is Some\n    }\n}\n\npub struct DynamicObjectView {\n    pub kind: Kind,\n    pub metadata: ObjectMetaView,\n    pub spec: Value,\n    pub status: Value,\n}\n\nimpl DynamicObjectView {\n    pub open spec fn object_ref(self) -> ObjectRef {\n        ObjectRef {\n            kind: self.kind,\n            name: self.metadata.name->0,\n            namespace: self.metadata.namespace->0,\n        }\n    }\n    pub open spec fn with_resource_version(self, rv: ResourceVersion) -> DynamicObjectView {\n        DynamicObjectView {\n            metadata: ObjectMetaView { resource_version: Some(rv), ..self.metadata },\n            ..self\n        }\n    }\n}\n\npub type StoredState = Map<ObjectRef, DynamicObjectView>;\n\npub struct APIServerState {\n    pub resources: StoredState,\n    pub uid_counter: Uid,\n    pub resource_version_counter: ResourceVersion,\n}\n\n// Lemma: same RV in s and s_prime implies same object (for handle_create_request case)\n// This is a key property needed for the main proof\nproof fn lemma_same_rv_implies_same_obj_create(\n    resources: StoredState, rv_counter: ResourceVersion,\n    new_resources: StoredState, new_rv_counter: ResourceVersion,\n    new_key: ObjectRef, new_obj: DynamicObjectView,\n)\n    requires\n        new_obj.metadata.resource_version == Some(rv_counter),\n        new_rv_counter == rv_counter + 1,\n        new_resources == resources.insert(new_key, new_obj),\n        // existing objects have rv < rv_counter\n        forall |key: ObjectRef| \n            #[trigger] resources.contains_key(key) \n            ==> resources[key].metadata.resource_version is Some\n                && resources[key].metadata.resource_version->0 < rv_counter,\n    ensures\n        // For any key in new_resources with rv < rv_counter, same as in resources\n        forall |key: ObjectRef|\n            #[trigger] new_resources.contains_key(key)\n            && new_resources[key].metadata.resource_version is Some\n            && new_resources[key].metadata.resource_version->0 < rv_counter\n            ==> resources.contains_key(key) && resources[key] == new_resources[key]\n{\n    assert forall |key: ObjectRef|\n        #[trigger] new_resources.contains_key(key)\n        && new_resources[key].metadata.resource_version is Some\n        && new_resources[key].metadata.resource_version->0 < rv_counter\n        implies resources.contains_key(key) && resources[key] == new_resources[key]\n    by {\n        if key == new_key {\n            // new_obj has rv = rv_counter, but we assumed rv < rv_counter\n            // contradiction\n            assert(new_resources[key] == new_obj);\n            assert(new_obj.metadata.resource_version->0 == rv_counter);\n           