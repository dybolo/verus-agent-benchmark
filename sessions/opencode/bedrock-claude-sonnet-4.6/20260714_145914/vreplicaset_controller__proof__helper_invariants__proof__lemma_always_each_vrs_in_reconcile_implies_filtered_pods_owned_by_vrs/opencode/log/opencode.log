timestamp=2026-07-14T14:05:52.144Z level=INFO run=36866cb2 message=evaluated permission=bash pattern="cat > /tmp/test_induction.rs << 'EOF'\nuse vstd::prelude::*;\n\nverus! {\n\npub struct Execution<T> {\n    pub nat_to_state: spec_fn(nat) -> T,\n}\n\nimpl<T> Execution<T> {\n    pub open spec fn head(self) -> T {\n        (self.nat_to_state)(0)\n    }\n    pub open spec fn head_next(self) -> T {\n        (self.nat_to_state)(1)\n    }\n    pub open spec fn suffix(self, pos: nat) -> Self {\n        Execution {\n            nat_to_state: |i: nat| (self.nat_to_state)(i + pos),\n        }\n    }\n}\n\npub type StatePred<T> = spec_fn(T) -> bool;\npub type ActionPred<T> = spec_fn(T, T) -> bool;\n\nproof fn init_invariant_induction_helper<T>(\n    ex: Execution<T>, \n    i: nat, \n    init: StatePred<T>, \n    next: ActionPred<T>, \n    inv: StatePred<T>\n)\n    requires\n        forall |s: T| #[trigger] init(s) ==> inv(s),\n        forall |s, s_prime: T| inv(s) && #[trigger] next(s, s_prime) ==> inv(s_prime),\n        init(ex.head()),\n        forall |j: nat| #[trigger] next(ex.suffix(j).head(), ex.suffix(j).head_next()),\n    ensures inv(ex.suffix(i).head())\n    decreases i\n{\n    if i == 0 {\n        // ex.suffix(0).head() == ex.head()\n        assert(ex.suffix(0 as nat).head() == ex.head()) by {\n            // Both reduce to ex.nat_to_state(0)\n        };\n    } else {\n        let i_minus_1 = (i - 1) as nat;\n        init_invariant_induction_helper(ex, i_minus_1, init, next, inv);\n        // We have inv(ex.suffix(i-1).head())\n        // We need next(ex.suffix(i-1).head(), ex.suffix(i).head())\n        assert(ex.suffix(i_minus_1).head_next() == ex.suffix(i).head()) by {\n            // ex.suffix(i-1).head_next() = (ex.nat_to_state)(1 + (i-1)) = (ex.nat_to_state)(i)\n            // ex.suffix(i).head() = (ex.nat_to_state)(0 + i) = (ex.nat_to_state)(i)\n        };\n        assert(next(ex.suffix(i_minus_1).head(), ex.suffix(i_minus_1).head_next()));\n    }\n}\n\nfn main() {}\n\n}\nEOF" action.permission=* action.action=allow action.pattern=*
