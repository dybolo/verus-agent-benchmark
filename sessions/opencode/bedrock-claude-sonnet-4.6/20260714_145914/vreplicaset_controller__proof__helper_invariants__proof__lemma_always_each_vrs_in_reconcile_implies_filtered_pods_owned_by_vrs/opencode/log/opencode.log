timestamp=2026-07-14T14:06:07.599Z level=INFO run=36866cb2 message=evaluated permission=bash pattern="cat > /tmp/test_init_inv.rs << 'EOF'\nuse vstd::prelude::*;\n\nverus! {\n\npub struct Execution<T> {\n    pub nat_to_state: spec_fn(nat) -> T,\n}\n\nimpl<T> Execution<T> {\n    pub open spec fn head(self) -> T { (self.nat_to_state)(0) }\n    pub open spec fn head_next(self) -> T { (self.nat_to_state)(1) }\n    pub open spec fn suffix(self, pos: nat) -> Self {\n        Execution { nat_to_state: |i: nat| (self.nat_to_state)(i + pos) }\n    }\n}\n\npub type StatePred<T> = spec_fn(T) -> bool;\npub type ActionPred<T> = spec_fn(T, T) -> bool;\n\npub struct TempPred<T> {\n    pub pred: spec_fn(Execution<T>) -> bool,\n}\n\nimpl<T> TempPred<T> {\n    pub open spec fn new(pred: spec_fn(Execution<T>) -> bool) -> Self { TempPred { pred } }\n    pub open spec fn satisfied_by(self, execution: Execution<T>) -> bool { (self.pred)(execution) }\n    pub open spec fn implies(self, other: Self) -> Self {\n        TempPred::new(|ex: Execution<T>| self.satisfied_by(ex) ==> other.satisfied_by(ex))\n    }\n    pub open spec fn entails(self, other: Self) -> bool { valid(self.implies(other)) }\n}\n\npub open spec fn lift_state<T>(state_pred: StatePred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| state_pred(ex.head()))\n}\npub open spec fn lift_action<T>(action_pred: ActionPred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| action_pred(ex.head(), ex.head_next()))\n}\npub open spec fn always<T>(temp_pred: TempPred<T>) -> TempPred<T> {\n    TempPred::new(|ex: Execution<T>| forall |i: nat| #[trigger] temp_pred.satisfied_by(ex.suffix(i)))\n}\npub open spec fn valid<T>(temp_pred: TempPred<T>) -> bool {\n    forall |ex: Execution<T>| temp_pred.satisfied_by(ex)\n}\n\nproof fn init_invariant_helper<T>(\n    ex: Execution<T>, i: nat, init: StatePred<T>, next: ActionPred<T>, inv: StatePred<T>\n)\n    requires\n        forall |s: T| #[trigger] init(s) ==> inv(s),\n        forall |s, s_prime: T| inv(s) && #[trigger] next(s, s_prime) ==> inv(s_prime),\n        init(ex.head()),\n        forall |j: nat| #[trigger] next(ex.suffix(j).head(), ex.suffix(j).head_next()),\n    ensures inv(ex.suffix(i).head())\n    decreases i\n{\n    if i == 0 {\n        assert(ex.suffix(0 as nat).head() == ex.head());\n    } else {\n        let j = (i - 1) as nat;\n        init_invariant_helper(ex, j, init, next, inv);\n        assert(ex.suffix(j).head_next() == ex.suffix(i).head());\n        assert(next(ex.suffix(j).head(), ex.suffix(j).head_next()));\n    }\n}\n\npub proof fn init_invariant<T>(spec: TempPred<T>, init: StatePred<T>, next: ActionPred<T>, inv: StatePred<T>)\n    requires\n        forall |s: T| #[trigger] init(s) ==> inv(s),\n        forall |s, s_prime: T| inv(s) && #[trigger] next(s, s_prime) ==> inv(s_prime),\n        spec.entails(lift_state(init)),\n        spec.entails(always(lift_action(next))),\n    ensures spec.entails(always(lift_state(inv)))\n{\n    assert forall |ex: Execution<T>| spec.satisfied_by(ex) implies always(lift_state(inv)).satisfied_by(ex) by {\n        assert forall |i: nat| #[trigger] lift_state(inv).satisfied_by(ex.suffix(i)) by {\n            assert(init(ex.head())) by {\n                assert(spec.entails(lift_state(init)));\n            };\n            assert(forall |j: nat| #[trigger] next(ex.suffix(j).head(), ex.suffix(j).head_next())) by {\n                assert(always(lift_action(next)).satisfied_by(ex));\n            };\n            init_invariant_helper(ex, i, init, next, inv);\n        };\n    };\n}\n\nfn main() {}\n\n}\nEOF" action.permission=* action.action=allow action.pattern=*
