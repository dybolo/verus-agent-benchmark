nal_body]\npub proof fn lemma_always_supporting(spec: TempPred<State>)\n    requires\n        spec.entails(lift_state(|s: State| s.v == 0 || s.v > 0)),\n        spec.entails(always(lift_action(|s: State, s_prime: State| s_prime.v == s.v + 1))),\n    ensures spec.entails(always(lift_state(|s: State| s.v >= 0)))\n{\n    unimplemented!()\n}\n\n// Main invariant that depends on supporting\npub open spec fn main_inv(s: State) -> bool {\n    s.w >= 0 && s.w <= s.v + 100\n}\n\n// Helper for main inv\nproof fn main_inv_helper(\n    spec: TempPred<State>,\n    ex: Execution<State>,\n    i: nat\n)\n    requires\n        spec.satisfied_by(ex),\n        spec.entails(lift_state(|s: State| s.v == 0 || s.v > 0)),\n        spec.entails(always(lift_action(|s: State, s_prime: State| s_prime.v == s.v + 1))),\n        // From init: v=0, w=0\n        ex.head() == State { v: 0, w: 0 },\n    ensures main_inv(ex.suffix(i).head())\n    decreases i\n{\n    // Get supporting invariant\n    lemma_always_supporting(spec);\n    // This gives us: forall j, s.v >= 0 at step j\n    \n    if i == 0 {\n        assert(ex.suffix(0 as nat).head() == ex.head());\n        assert(main_inv(ex.head()));\n    } else {\n        main_inv_helper(spec, ex, (i-1) as nat);\n        let s = ex.suffix((i-1) as nat).head();\n        let s_prime = ex.suffix(i).head();\n        // next(s, s_prime)\n        assert(always(lift_action(|s: State, s_prime: State| s_prime.v == s.v + 1)).satisfied_by(ex));\n        // ...\n    }\n}\n\nfn main() {}\n\n}\nEOF" action.permission=* action.action=allow action.pattern=*
