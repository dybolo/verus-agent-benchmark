igger] init(s) ==> inv(s),\n        forall |s, s_prime: T| inv(s) && #[trigger] next(s, s_prime) ==> inv(s_prime),\n        init(ex.head()),\n        forall |j: nat| #[trigger] next(ex.suffix(j).head(), ex.suffix(j).head_next()),\n    ensures inv(ex.suffix(i).head())\n    decreases i\n{\n    if i == 0 {\n        assert(ex.suffix(0 as nat).head() == ex.head());\n    } else {\n        let j = (i - 1) as nat;\n        init_invariant_helper(ex, j, init, next, inv);\n        assert(ex.suffix(j).head_next() == ex.suffix(i).head());\n        assert(next(ex.suffix(j).head(), ex.suffix(j).head_next()));\n    }\n}\n\npub proof fn init_invariant<T>(spec: TempPred<T>, init: StatePred<T>, next: ActionPred<T>, inv: StatePred<T>)\n    requires\n        forall |s: T| #[trigger] init(s) ==> inv(s),\n        forall |s, s_prime: T| inv(s) && #[trigger] next(s, s_prime) ==> inv(s_prime),\n        spec.entails(lift_state(init)),\n        spec.entails(always(lift_action(next))),\n    ensures spec.entails(always(lift_state(inv)))\n{\n    // spec.entails(P) = valid(spec.implies(P)) = forall ex, spec(ex) ==> P(ex)\n    assert forall |ex: Execution<T>| #[trigger] spec.satisfied_by(ex) implies always(lift_state(inv)).satisfied_by(ex) by {\n        // From spec.entails(lift_state(init)):\n        // valid(spec.implies(lift_state(init))) means forall ex, spec(ex) ==> init(ex.head())\n        let h1 = lift_state(init);\n        let h2 = always(lift_action(next));\n        assert(spec.entails(h1));\n        assert(spec.entails(h2));\n        assert(valid(spec.implies(h1)));\n        assert(valid(spec.implies(h2)));\n        // Now we are inside the assumption spec.satisfied_by(ex)\n        // h1.satisfied_by(ex) means init(ex.head())\n        assert(h1.satisfied_by(ex));\n        assert(init(ex.head()));\n        // h2.satisfied_by(ex) means forall j, next(ex.suffix(j).head(), ex.suffix(j).head_next())\n        assert(h2.satisfied_by(ex));\n        assert(forall |j: nat| #[trigger] next(ex.suffix