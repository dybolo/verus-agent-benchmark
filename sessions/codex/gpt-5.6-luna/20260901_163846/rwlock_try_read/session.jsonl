ct_token.split_one();\n                    retract_read_token = Some(one);\n                }\n            }\n        );\n        proof {\n            assert(lock as int == first_prev as int);\n            assert(first_next as int == first_prev as int + READER as int);\n        }\n        if lock & (WRITER | MAX_READER | BEING_UPGRADED) == 0 {\n            Some(\n                RwLockReadGuard {\n                    inner: self,\n                    guard,\n                    tracked_token: Tracked(read_token.tracked_unwrap()),\n                },\n            )\n        } else {\n            proof {\n                assert(failed);\n                assert(retract_read_token is Some);\n            }\n            atomic_with_ghost!(\n                self.lock => fetch_sub(READER);\n                update prev -> next;\n                ghost g => {\n                    if failed {\n                        let tracked one = retract_read_token.tracked_unwrap();\n                        g.read_retract_token.combine(one);\n                    }\n                    lemma_consts_properties_value(prev as usize);\n                    lemma_consts_properties_prev_next(prev as usize, next as usize);\n                }\n            );\n            None\n        }\n    }\n\n}\n\n\n","exit_code":0,"status":"completed"},"received_at":"2026-09-01T17:10:26.586Z"}
