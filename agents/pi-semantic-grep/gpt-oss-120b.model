#!/bin/sh

EXTRA_PROMPT="Please define a structured proof plan for your verification problem (covering: what needs to be shown, assumptions, key ideas, high-level strategy, sub-goals) and use the semantic_grep tool to help you complete your task."
pi --model openai/gpt-oss-120b:free:xhigh --session-dir "$SESSION" -t read,bash,edit,write,find,ls,semantic_grep -p "$TASK_PROMPT $EXTRA_PROMPT"
