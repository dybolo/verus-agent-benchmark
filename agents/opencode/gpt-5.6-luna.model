#!/bin/bash
set -euo pipefail

if [[ -z "${BENCHMARK_AGENT_AUTH_DIR:-}" ]] ||
    [[ ! -f "$BENCHMARK_AGENT_AUTH_DIR/opencode/auth.json" ]]; then
    echo "Missing OpenCode ChatGPT credentials. Follow the ChatGPT subscription setup in README.md." >&2
    exit 1
fi

export XDG_DATA_HOME="$BENCHMARK_AGENT_AUTH_DIR"
export XDG_STATE_HOME="$SESSION/opencode-state"
export XDG_CACHE_HOME="$SESSION/opencode-cache"

opencode run --dangerously-skip-permissions --format json \
    -m openai/gpt-5.6-luna "$TASK_PROMPT" \
    > "$SESSION/session.jsonl"
