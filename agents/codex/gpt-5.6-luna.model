#!/bin/sh
set -eu

if [ -z "${BENCHMARK_AGENT_AUTH_DIR:-}" ] ||
    [ ! -f "$BENCHMARK_AGENT_AUTH_DIR/auth.json" ]; then
    echo "Missing Codex ChatGPT credentials. Follow the ChatGPT subscription setup in README.md." >&2
    exit 1
fi

export CODEX_HOME="$BENCHMARK_AGENT_AUTH_DIR"

codex exec -m gpt-5.6-luna --dangerously-bypass-approvals-and-sandbox \
    --skip-git-repo-check --json "$TASK_PROMPT" > "$SESSION/session.jsonl"
