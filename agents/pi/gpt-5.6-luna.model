#!/bin/sh
set -eu

if [ -z "${BENCHMARK_AGENT_AUTH_DIR:-}" ] ||
    [ ! -f "$BENCHMARK_AGENT_AUTH_DIR/auth.json" ]; then
    echo "Missing Pi ChatGPT credentials. Follow the ChatGPT subscription setup in README.md." >&2
    exit 1
fi

export PI_CODING_AGENT_DIR="$BENCHMARK_AGENT_AUTH_DIR"

pi --model openai-codex/gpt-5.6-luna \
    --session-dir "$SESSION" -p "$TASK_PROMPT"
