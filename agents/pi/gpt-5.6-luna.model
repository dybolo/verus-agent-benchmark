#!/bin/sh
set -eu

if [ -z "${BENCHMARK_AGENT_AUTH_FILE:-}" ] ||
    [ ! -f "$BENCHMARK_AGENT_AUTH_FILE" ]; then
    echo "Missing Pi ChatGPT credentials. Follow the ChatGPT subscription setup in README.md." >&2
    exit 1
fi

export PI_CODING_AGENT_DIR="$(dirname "$BENCHMARK_AGENT_AUTH_FILE")"

pi --tools read,write,edit,bash,grep,find,ls \
    --model openai-codex/gpt-5.6-luna \
    --session "$SESSION/session.jsonl" -p "$TASK_PROMPT"
