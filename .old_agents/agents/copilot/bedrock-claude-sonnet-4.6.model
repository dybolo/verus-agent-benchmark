#!/bin/sh

cat > /tmp/litellm_config.yaml << 'EOF'
model_list:
  - model_name: claude-sonnet-4.6
    litellm_params:
      model: bedrock/global.anthropic.claude-sonnet-4-6
      api_key: os.environ/AWS_BEARER_TOKEN_BEDROCK
      aws_region_name: eu-west-1
    model_info:
      mode: chat
      input_cost_per_token: 0.000003
      output_cost_per_token: 0.000015
      cache_read_input_token_cost: 0.0000003
      cache_creation_input_token_cost: 0.00000375
general_settings:
  disable_master_key_required: true
litellm_settings:
  enable_anthropic_prompt_caching: true
EOF

litellm --port 11434 --config /tmp/litellm_config.yaml &
LITELLM_PID=$!

for i in $(seq 1 30); do
  curl -s http://localhost:11434/health > /dev/null 2>&1 && break
  sleep 0.5
done

export COPILOT_PROVIDER_TYPE="openai"
export COPILOT_PROVIDER_BASE_URL="http://localhost:11434/v1"
export COPILOT_MODEL="claude-sonnet-4.6"
export COPILOT_HOME="$SESSION"
export XDG_CACHE_HOME="$SESSION/cache"
mkdir -p "$XDG_CACHE_HOME"

copilot --autopilot -p "$TASK_PROMPT" --allow-all-tools --allow-all-paths -s

kill $LITELLM_PID 2>/dev/null
